{
	"name": "@crafter/sunat-cli",
	"version": "0.11.1",
	"description": "Agent-first CLI for SUNAT tax automation",
	"module": "bin/sunat.ts",
	"type": "module",
	"license": "MIT",
	"homepage": "https://sunat-cli.crafter.ing",
	"repository": {
		"type": "git",
		"url": "https://github.com/crafter-research/sunat-cli",
		"directory": "packages/cli"
	},
	"keywords": [
		"sunat",
		"peru",
		"tax",
		"cli",
		"agent",
		"automation",
		"rhe",
		"f616",
		"gov-tech",
		"agent-browser",
		"cdp"
	],
	"bin": {
		"sunat-cli": "dist/sunat.js"
	},
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist",
		"bin",
		"src",
		"!src/**/RESEARCH.md",
		"!src/**/SIRE-RESEARCH.md",
		"skills",
		"README.md",
		"LIMITATIONS.md"
	],
	"scripts": {
		"dev": "bun run bin/sunat.ts",
		"build": "bun run scripts/build.ts",
		"check": "biome check --write .",
		"test": "bun test",
		"test:unit": "bun test tests/unit",
		"test:e2e": "bun test tests/e2e",
		"smoke:sunat": "bash scripts/smoke-sunat.sh",
		"smoke:boleta": "bash scripts/smoke-boleta.sh",
		"smoke:padron": "bash scripts/smoke-padron.sh"
	},
	"dependencies": {
		"@clack/prompts": "^1.1.0",
		"@xmldom/xmldom": "^0.9.10",
		"commander": "15.0.0",
		"fast-xml-parser": "5.11.0",
		"node-forge": "^1.4.0",
		"xml-crypto": "^6.1.2",
		"yauzl": "^3.3.0",
		"yazl": "^3.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/bun": "1.4.0",
		"@types/node-forge": "^1.3.14",
		"@types/yauzl": "^3.4.0",
		"@types/yazl": "^3.3.1"
	},
	"peerDependencies": {
		"agent-browser": ">=0.22"
	},
	"peerDependenciesMeta": {
		"agent-browser": {
			"optional": true
		}
	}
}
