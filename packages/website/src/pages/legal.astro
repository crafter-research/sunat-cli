---
import Base from "../layouts/Base.astro";
import Legal from "../components/Legal.astro";
import { useLegal } from "../lib/content";

const l = useLegal("es");
---

<Base
	locale="es"
	path="/legal"
	title={`${l.title} — sunat-cli`}
	description="Marco legal, responsabilidad del usuario, protección de datos y descargo de responsabilidad de sunat-cli."
>
	<Legal locale="es" />
</Base>
